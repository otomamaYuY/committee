#!/bin/sh
# Rejects a commit message that does not follow Conventional Commits.
# Installed by committee. The allowed types live in
# .claude/git-conventions.yaml, which commitlint.config.js reads directly.
set -e

# Say what is missing rather than letting npx fail in its own words: a
# developer whose every commit is rejected by an unexplained error reaches
# for --no-verify, which turns the whole enforcement layer off.
#
# `require.resolve` walks up parent node_modules exactly as npx does, so it
# is right in a monorepo too, and it skips the package-resolution step npx
# performs — which is most of npx's startup, on a path git blocks on for
# every single commit.
if ! node -e 'require.resolve("@commitlint/cli")' >/dev/null 2>&1; then
  echo "commit-msg: commitlint is not installed in this repository." >&2
  echo "            Install the dev dependencies:  npm install" >&2
  echo "            (pnpm install / yarn install work the same way.)" >&2
  exit 1
fi

# `npx --no` deliberately refuses to fetch on demand: a hook that silently
# downloads a linter mid-commit is worse than one that fails.

exec npx --no -- commitlint --edit "$1"
